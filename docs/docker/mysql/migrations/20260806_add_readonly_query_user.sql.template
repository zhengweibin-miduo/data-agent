-- Expand the deployed DW schema and dedicated read-only credentials with envsubst.
CREATE USER IF NOT EXISTS '${QUERY_USER}'@'%' IDENTIFIED BY '${QUERY_PASSWORD}';
ALTER USER '${QUERY_USER}'@'%' IDENTIFIED BY '${QUERY_PASSWORD}';
REVOKE ALL PRIVILEGES, GRANT OPTION FROM '${QUERY_USER}'@'%';
GRANT SELECT ON `${DW_DATABASE}`.* TO '${QUERY_USER}'@'%';
FLUSH PRIVILEGES;
